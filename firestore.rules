rules_version = '2';

// Finova's authoritative demo data is written only by Node route handlers
// using Firebase Admin. Browsers receive it through authenticated APIs, not
// direct Firestore documents, so they cannot mutate balances or request state.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
